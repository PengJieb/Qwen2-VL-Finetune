{
    "train_batch_size": 4,
    "eval_batch_size": 4,
    "gradient_accumulation_steps": 1,
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 1e-5,
            "betas": [0.9, 0.999],
            "eps": 1e-8
        }
    },
    "zero_optimization": {
        "stage": 0,
        "offload_optimizer": {
            "device": "none" 
        },
        "offload_param": {
            "device": "none"
        },
        "overlap_comm": true, 
        "contiguous_gradients": true,
        "reduce_bucket_size": 262144,
        "round_robin_gradients": false
    },
    "fp16": {
        "enabled": false  
    },
    "bf16": {
        "enabled": true
    },
    "dist_init_required": true,
    "verbose": 1, 
    "gradient_clipping": 1.0,
    "prescale_gradients": false,
    "wall_clock_breakdown": false
}